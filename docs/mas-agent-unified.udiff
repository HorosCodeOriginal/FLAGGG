diff --git a/.github/workflows/harness-pro.yml b/.github/workflows/harness-pro.yml
new file mode 100644
index 0000000..8cb4c9d
--- /dev/null
+++ b/.github/workflows/harness-pro.yml
@@ -0,0 +1,45 @@
+name: harness-pro tests
+
+on:
+  push:
+    paths:
+      - 'harness-pro/**'
+      - '.github/workflows/harness-pro.yml'
+  pull_request:
+    paths:
+      - 'harness-pro/**'
+      - '.github/workflows/harness-pro.yml'
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: harness-pro
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: npm
+          cache-dependency-path: harness-pro/package-lock.json
+
+      - name: Install Electron system libraries
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            libgtk-3-0 libnotify4 libnss3 libxss1 libxtst6 \
+            xdg-utils libatspi2.0-0 libuuid1 libsecret-1-0 \
+            libasound2 xvfb
+
+      - name: npm ci
+        run: npm ci
+
+      - name: Rebuild better-sqlite3 for Electron
+        run: npx electron-rebuild -f -w better-sqlite3
+
+      - name: Run tests (Electron as Node)
+        run: npm test
+        env:
+          ELECTRON_RUN_AS_NODE: '1'
