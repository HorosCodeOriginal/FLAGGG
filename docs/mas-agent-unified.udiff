diff --git a/README.md b/README.md
new file mode 100644
index 0000000..4d712a4
--- /dev/null
+++ b/README.md
@@ -0,0 +1,106 @@
+# FLAGGG ÔÇö Distributed Multi-Agent System
+
+Lokale, autonome Multi-Agenten-Firma: isolierte Gateway-Endpunkte (Docker) und ein Electron-Cockpit mit Task-Queue, Graph-Routing und Self-Healing.
+
+## Architektur
+
+```mermaid
+flowchart TB
+  subgraph gateway [fr-gateway]
+    Manager[manager_watch]
+    Panel[panel_8090]
+    GW1[OpenResty_key_1]
+    GW2[OpenResty_key_N]
+    Manager --> GW1
+    Manager --> GW2
+    Panel --> Manager
+    GW1 --> Upstream[FlagshipRouter_Upstream]
+    GW2 --> Upstream
+  end
+
+  subgraph harness [harness-pro_Electron]
+    UI[Canvas_UI]
+    Main[main.js]
+    Orch[Orchestrator]
+    TQ[TaskQueue_SQLite_FSM]
+    RT[AgentRuntimes]
+    TR[ToolRunner]
+    UI --> Main
+    Main --> Orch
+    Orch --> RT
+    Orch --> TQ
+    RT --> TQ
+    RT --> TR
+    Main --> GW1
+  end
+```
+
+**fr-gateway:** Docker Compose startet Manager + Panel und bis zu ~46 isolierte OpenResty-Container (ein Token/Port). Token-Limits, Failover-Kette, Upstream-Pool.
+
+**harness-pro:** Electron-Desktop. SQLite-Task-Queue, Rollen-Graph, parallele Runtimes (Semaphore), ToolRunner, Synthesizer, Live-Canvas.
+
+## Features
+
+- **Task-Queue + FSM:** `queued ÔåÆ claimed ÔåÆ running ÔåÆ waiting_on_child ÔåÆ done/failed` (strikt)
+- **Graph-Routing:** `superiors` / `subordinates` / `peers` ÔÇö Policy steuert, wer an wen Tasks senden darf
+- **Self-Healing-Loop:** Sub-Fehler (`stderr`) ÔåÆ `error_history` ÔåÆ Boss liest Fehler ÔåÆ Fix-Task ÔåÆ Sub heilt (z.ÔÇ»B. `pip install`) und wiederholt
+- **ToolRunner:** `read_file`, `write_file`, `execute_shell`, `web_search`, `web_fetch`, `download_file`, plus `install_skill` (Plugin-Sandbox)
+- **Synthesizer:** Kind-Ergebnisse ÔåÆ kompakter Report (Attention Economy)
+
+## Setup
+
+### 1. Secrets (nie committen)
+
+```bash
+cd fr-gateway
+cp keys_raw.txt.example secrets/keys_raw.txt
+# echte Upstream-Keys eintragen (eine Zeile pro Key)
+
+cp registry.example.json secrets/registry.json
+# Ports / unique_key / model_family anpassen
+```
+
+Secrets nur ├╝ber lokale Dateien unter `fr-gateway/secrets/` (gitignored), `.env` oder Docker-Secrets ÔÇö **niemals** im Repo.
+
+### 2. Gateway starten
+
+```bash
+cd fr-gateway
+docker compose up -d --build
+```
+
+Panel: http://127.0.0.1:8090
+
+### 3. Astra Harness
+
+```bash
+cd harness-pro
+npm install
+npm test
+npm run seed-goal   # optional: Demo-Goal in die Queue
+npm start
+```
+
+Optional: `harness-pro/data/astra-key.txt` mit dem Gateway-Token (Pfad liegt unter `**/data/` und ist gitignored).
+
+## Tests / CI
+
+```bash
+cd harness-pro && npm test
+```
+
+GitHub Actions: `.github/workflows/harness-pro.yml`
+
+## Security-Hinweis
+
+- `fr-gateway/secrets/`, `keys_raw.txt`, `**/data/`, `**/logs/`, `**/workspaces/` sind in `.gitignore`.
+- Rohe `sk-ÔÇª` / `vkd-ÔÇª` Keys geh├Âren nicht in Git, Diffs oder Issues.
+- Agent-`execute_shell` l├ñuft im Workspace ÔÇö nur in vertrauensw├╝rdiger lokaler Umgebung nutzen.
+
+## Legacy
+
+`astra-harness/`, `claude-harness/`, `fr-harness/` sind ├ñltere Kopien und nicht Teil der CI.
+
+## Lizenz
+
+MIT (Harness). Upstream-Zugang und Keys bleiben privat.
diff --git a/check-app-health.ps1 b/check-app-health.ps1
new file mode 100644
index 0000000..6ef6fdc
--- /dev/null
+++ b/check-app-health.ps1
@@ -0,0 +1,111 @@
+# ============================================================================
+#  check-app-health.ps1 ÔÇö READ-ONLY Gesundheitscheck der Harness-Kette
+#  App (Electron) -> fr-gateway (Docker, pro Key) -> FlagshipRouter :20128 -> Provider
+#
+#  Aufruf:  .\check-app-health.ps1
+#  Es wird NICHTS ver├ñndert (keine Neustarts, keine Schreibzugriffe).
+# ============================================================================
+$ErrorActionPreference = 'Continue'
+$ROOT = $PSScriptRoot; if (-not $ROOT) { $ROOT = (Get-Location).Path }
+$REG = Join-Path $ROOT 'fr-gateway\secrets\registry.json'
+$UPSTREAM = 'http://127.0.0.1:20128/v1'
+$PANEL = 'http://127.0.0.1:8090'
+
+function Line($t) { Write-Host $t }
+function Ok($t)   { Write-Host "  [OK]   $t" -ForegroundColor Green }
+function Bad($t)  { Write-Host "  [FEHL] $t" -ForegroundColor Red }
+function Info($t) { Write-Host "  [info] $t" -ForegroundColor DarkGray }
+
+Line ''
+Line '=== 1) Docker / Gateway-Container ==='
+try {
+    $running = (docker ps --filter 'name=fr-key-' --format '{{.Names}}' 2>$null | Measure-Object -Line).Lines
+    $unhealthy = (docker ps --filter 'name=fr-key-' --filter 'health=unhealthy' --format '{{.Names}}' 2>$null | Measure-Object -Line).Lines
+    if ($running -gt 0) { Ok "$running Key-Container laufen, $unhealthy unhealthy" } else { Bad 'keine Key-Container aktiv' }
+} catch { Bad "docker nicht erreichbar: $($_.Exception.Message)" }
+
+Line ''
+Line '=== 2) Panel (fr-panel :8090) ==='
+try {
+    $fleet = Invoke-RestMethod -Uri "$PANEL/api/fleet" -TimeoutSec 10
+    Ok "Panel antwortet, Fleet-Eintr├ñge: $($fleet.Count)"
+} catch { Bad "Panel: $($_.Exception.Message)" }
+
+Line ''
+Line '=== 3) Registry / Key-Auth (Stichprobe 3) ==='
+$entries = @()
+try {
+    $entries = Get-Content $REG -Raw | ConvertFrom-Json
+    Ok "Registry lesbar, $($entries.Count) Eintr├ñge"
+} catch { Bad "Registry nicht lesbar: $($_.Exception.Message)" }
+$authOk = 0; $authBad = 0
+foreach ($e in ($entries | Select-Object -First 3)) {
+    try {
+        $r = Invoke-WebRequest -Uri "http://127.0.0.1:$($e.port)/v1/models" -Headers @{ Authorization = "Bearer $($e.unique_key)" } -UseBasicParsing -TimeoutSec 8
+        if ($r.StatusCode -eq 200) { $authOk++ } else { $authBad++ }
+    } catch { $authBad++ }
+}
+if ($authOk -gt 0 -and $authBad -eq 0) { Ok "Key-Auth + /v1/models: $authOk/3 OK" } else { Bad "Key-Auth: $authOk OK, $authBad Fehler" }
+
+# Upstream-Key nur aus Env oder erster Zeile von secrets/keys_raw.txt (nie hardcoden)
+$UPSTREAM_KEY = $env:FLAGGG_UPSTREAM_KEY
+if (-not $UPSTREAM_KEY) {
+    $keysFile = Join-Path $ROOT 'fr-gateway\secrets\keys_raw.txt'
+    if (Test-Path $keysFile) {
+        $UPSTREAM_KEY = (Get-Content $keysFile -ErrorAction SilentlyContinue |
+            Where-Object { $_ -and $_ -notmatch '^\s*#' } |
+            Select-Object -First 1)
+    }
+}
+
+Line ''
+Line '=== 4) Upstream-Router (:20128) ==='
+if (-not $UPSTREAM_KEY) {
+    Bad 'kein Upstream-Key (FLAGGG_UPSTREAM_KEY oder fr-gateway/secrets/keys_raw.txt)'
+    $ids = @()
+} else {
+try {
+    $models = Invoke-RestMethod -Uri "$UPSTREAM/models" -Headers @{ Authorization = "Bearer $UPSTREAM_KEY" } -TimeoutSec 15
+    $ids = @($models.data | ForEach-Object { $_.id })
+    Ok "Router erreichbar, $($ids.Count) Modelle"
+    Info ($ids -join ', ')
+} catch { Bad "Router: $($_.Exception.Message)"; $ids = @() }
+}
+
+Line ''
+Line '=== 5) Chat-Probe (1 Modell, 8 Tokens) ==='
+if ($ids.Count -gt 0 -and $UPSTREAM_KEY) {
+    $probe = 'gpt-6-astra'
+    if ($ids -notcontains $probe) { $probe = $ids[0] }
+    $body = @{ model = $probe; messages = @(@{ role = 'user'; content = 'ping' }); stream = $false; max_tokens = 8 } | ConvertTo-Json -Depth 5
+    try {
+        $r = Invoke-WebRequest -Uri "$UPSTREAM/chat/completions" -Method Post -Body $body -ContentType 'application/json' -Headers @{ Authorization = "Bearer $UPSTREAM_KEY" } -UseBasicParsing -TimeoutSec 60
+        Ok "Chat funktioniert (HTTP $($r.StatusCode), Modell $probe)"
+    } catch {
+        $resp = $_.Exception.Response
+        $code = if ($resp) { $resp.StatusCode.value__ } else { 'ERR' }
+        $msg = [string]$_.ErrorDetails.Message
+        if (-not $msg) { $msg = $_.Exception.Message }
+        $msg = ($msg -replace '\\u0022', '"') -replace '\s+', ' '
+        Bad "Chat fehlgeschlagen: HTTP $code"
+        Info $msg.Substring(0, [Math]::Min(240, $msg.Length))
+        Line ''
+        Line '  Einordnung:'
+        if ($msg -match 'FreeUsageLimitError|Free usage limit') {
+            Info '  -> Upstream-Provider (OpenCode) hat das kostenlose Kontingent aufgebraucht.'
+            Info '     Ursache liegt NICHT in der App und NICHT im fr-gateway.'
+        } elseif ($msg -match 'daily token limit') {
+            Info '  -> fr-gateway Tageslimit (2 Mio. Tokens) erreicht.'
+        } elseif ($msg -match 'ModelDeprecated|Unsupported model|Model is unavailable|not available in') {
+            Info '  -> Modell/Provider beim Upstream nicht verf├╝gbar oder abgek├╝ndigt.'
+        } elseif ($msg -match 'unauthorized|invalid_api_key') {
+            Info '  -> Zugangsdaten/Key ung├╝ltig.'
+        }
+    }
+}
+
+Line ''
+Line '=== 6) Fazit ==='
+Line '  App-Kette (Electron/Fenster, Panel, Gateway-Container, Key-Auth, /v1/models)'
+Line '  = oben gr├╝n. Reicht die Chat-Probe Rot, liegt der Fehler beim Upstream-Provider.'
+Line ''
diff --git a/docs/audit-mas.md b/docs/audit-mas.md
new file mode 100644
index 0000000..0b2623b
--- /dev/null
+++ b/docs/audit-mas.md
@@ -0,0 +1,36 @@
+# FLAGGG MAS ÔÇö Audit (2026-10-26)
+
+Kurzreport: Findings aus dem Handoff-Audit, Fixes und bewusst Zur├╝ckgestelltes.
+
+## Behoben (dieser Durchgang)
+
+| Severity | Thema | Fix |
+|----------|--------|-----|
+| HIGH | `updateState` ohne CAS | `WHERE id=? AND state=?`, Fehler bei `changesÔëá1` |
+| HIGH | Child fertig vor `waiting_on_child` | `delegateTask`: zuerst `waiting_on_child`, dann `enqueue`, dann `checkChildrenStatus` |
+| HIGH | Parallele Synthese / Doppel-Reports | `markSynthesized` CAS + Claim-vor-Enqueue; Worker serialisiert `synthesize` |
+| HIGH | Symlink-Escape in ToolRunner | `_resolveInside` mit `realpath` |
+| HIGH | SSRF web_fetch/download/install | Private/link-local/localhost blocken; Redirects manuell + erneut pr├╝fen |
+| MED | `teams`-Map Leak | `finally { teams.delete }` |
+| MED | Quit ohne Abort | `before-quit` abortet `streams` + `teams` |
+
+Zus├ñtzlich: GitHub-Readiness (`.gitignore`, README, CI), Plugin-Sandbox (`install_skill` / VM).
+
+## Zur├╝ckgestellt (bewusst)
+
+| Severity | Thema | Warum |
+|----------|--------|--------|
+| CRITICAL (Produkt) | Uneingeschr├ñnktes `execute_shell` | Self-Heal braucht `pip`/`npm`; Risiko im README dokumentiert. Follow-up: engeres Allowlisting oder Job-Object-Sandbox. |
+| MED | Quota-Backoff Multi-Conn Edge | CAS erg├ñnzt; Concurrent-429-Tests optional. |
+| MED | Watchdog vs. complete Multi-Conn | CAS mindert; dedizierter Race-Test optional. |
+| LOW | Orphan-State `claimed` | Watchdog sweep nur `running`/`waiting_on_child`. Follow-up: claimed-TTL. |
+| MED | stderr ÔåÆ Boss-Prompt Injection | Truncation existiert teilweise; h├ñrtere Delimiter/Sanitizer Follow-up. |
+| INFO | UI-Plugin-Marketplace | Bleibt Mock; echte Registry nur ├╝ber ToolRunner-Skills. |
+
+## Verifikation
+
+```bash
+cd harness-pro && npm test
+```
+
+Neue Tests: `test/race-cas.test.js`, `test/skill-sandbox.test.js`, `test/install-skill.test.js`.
diff --git a/fr-gateway/bin/fr-manager b/fr-gateway/bin/fr-manager
new file mode 100644
index 0000000..0684209
--- /dev/null
+++ b/fr-gateway/bin/fr-manager
@@ -0,0 +1,429 @@
+#!/usr/bin/env python3
+# language: python3, file: fr-manager, runtime: stdlib only, target: ubuntu/debian host
+"""
+fr-manager ÔÇö watcher/orchestrator fuer fr-gateway container.
+
+Aufgaben:
+  - keys_raw.txt ueberwachen (alle 30s), neue Keys als eigenen Container starten
+  - Hostport fortlaufend ab 20129, persistente Zuteilung in registry.json
+  - model_family: position in keys_raw.txt (1-22 astra, 23+ opus)
+  - keys.map.json (unique_key -> raw_key) aendern -> betroffene Container neu setzen
+  - --status: Tabelle nr | key-hash | port | container | state | family | tokens | limit | reset
+  - --reaper: Keys die fehlen -> Container stoppen/entfernen (Volume bleibt)
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+import socket
+import subprocess
+import sys
+import time
+
+BASE = "/opt/fr-gateway"
+KEYS_FILE = os.path.join(BASE, "keys_raw.txt")
+MAP_FILE = os.path.join(BASE, "keys.map.json")
+REGISTRY_FILE = os.path.join(BASE, "registry.json")
+GATEWAY_DIR = os.path.join(BASE, "gateway")
+IMAGE = "fr-gateway:latest"
+
+SEED_PORT = 20129
+PORT_SPAN = 128
+DAILY_LIMIT_DEFAULT = 2000000
+ASTRA_COUNT = 22
+LOG_DIR = "/var/log/fr-gateway"
+DATA_ROOT = "/var/lib/fr-gateway"
+WATCH_INTERVAL = 30
+
+# Nie echte Keys im Repo. Seed nur aus KEYS_FILE / Docker-Secrets.
+SEED_KEYS = []
+
+
+def log(msg, level="info"):
+    ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    line = "[%s] [%s] %s" % (ts, level, msg)
+    print(line, flush=True)
+    try:
+        os.makedirs(LOG_DIR, exist_ok=True)
+        with open(os.path.join(LOG_DIR, "manager.log"), "a", encoding="utf-8") as f:
+            f.write(line + "\n")
+    except Exception:
+        pass
+
+
+def run(cmd, timeout=120, check=True):
+    try:
+        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        log("timeout: " + " ".join(cmd), "error")
+        return 124, "", "timeout"
+    if check and p.returncode != 0:
+        log("cmd fehlgeschlagen (%d): %s" % (p.returncode, " ".join(cmd)), "error")
+        log("stdout: " + p.stdout[-2000:], "error")
+        log("stderr: " + p.stderr[-2000:], "error")
+    return p.returncode, p.stdout, p.stderr
+
+
+# ---------------------------------------------------------------------------
+# registry (liste von eintraegen)
+# ---------------------------------------------------------------------------
+
+def registry_load():
+    if not os.path.exists(REGISTRY_FILE):
+        return []
+    try:
+        with open(REGISTRY_FILE, "r", encoding="utf-8") as f:
+            data = json.load(f)
+        if isinstance(data, list):
+            return data
+    except Exception as e:
+        log("registry defekt: %s" % e, "error")
+    return []
+
+
+def registry_save(reg):
+    os.makedirs(BASE, exist_ok=True)
+    tmp = REGISTRY_FILE + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(reg, f, indent=2, sort_keys=True)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, REGISTRY_FILE)
+
+
+# ---------------------------------------------------------------------------
+# keys / map
+# ---------------------------------------------------------------------------
+
+def key_hash(key):
+    return hashlib.sha256(key.encode("utf-8")).hexdigest()
+
+
+def container_name(key):
+    return "fr-key-" + key_hash(key)[:12]
+
+
+def read_keys():
+    if not os.path.exists(KEYS_FILE):
+        return []
+    out = []
+    with open(KEYS_FILE, "r", encoding="utf-8") as f:
+        for ln in f:
+            ln = ln.strip()
+            if ln and not ln.startswith("#"):
+                out.append(ln)
+    return out
+
+
+def load_map():
+    if not os.path.exists(MAP_FILE):
+        return {}
+    try:
+        with open(MAP_FILE, "r", encoding="utf-8") as f:
+            m = json.load(f)
+        if isinstance(m, dict):
+            return m
+    except Exception as e:
+        log("map defekt: %s" % e, "error")
+    return {}
+
+
+def raw_to_unique(map_data, raw):
+    for u, r in map_data.items():
+        if r == raw:
+            return u
+    return None
+
+
+# ---------------------------------------------------------------------------
+# docker
+# ---------------------------------------------------------------------------
+
+def port_in_use(port):
+    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    s.settimeout(0.3)
+    try:
+        return s.connect_ex(("127.0.0.1", port)) == 0
+    finally:
+        s.close()
+
+
+def next_free_port(reg, avoid=None):
+    used = {e.get("port") for e in reg if e.get("port")}
+    avoid = avoid or set()
+    for p in range(SEED_PORT, SEED_PORT + PORT_SPAN):
+        if p in used or p in avoid:
+            continue
+        if not port_in_use(p):
+            return p
+    return None
+
+
+def ensure_image():
+    rc, _, _ = run(["docker", "image", "inspect", IMAGE], check=False)
+    if rc == 0:
+        return True
+    log("baue image %s" % IMAGE)
+    rc, _, _ = run(["docker", "build", "-t", IMAGE, GATEWAY_DIR], timeout=600, check=False)
+    return rc == 0
+
+
+def container_exists(name):
+    rc, _, _ = run(["docker", "inspect", name], check=False)
+    return rc == 0
+
+
+def container_running(name):
+    rc, out, _ = run(["docker", "inspect", "--format", "{{.State.Running}}", name], check=False)
+    if rc != 0:
+        return None
+    return out.strip() == "true"
+
+
+def container_env(name):
+    rc, out, _ = run(
+        ["docker", "inspect", "--format", "{{range .Config.Env}}{{.}}\n{{end}}", name],
+        check=False,
+    )
+    if rc != 0:
+        return {}
+    env = {}
+    for line in out.splitlines():
+        if "=" in line:
+            k, v = line.split("=", 1)
+            env[k] = v
+    return env
+
+
+def start_container(entry, raw_key):
+    name = entry["container"]
+    limit = entry.get("limit_override") or DAILY_LIMIT_DEFAULT
+    vol_cnt = os.path.join(DATA_ROOT, name)
+    vol_log = os.path.join(LOG_DIR, name)
+    os.makedirs(vol_cnt, exist_ok=True)
+    os.makedirs(vol_log, exist_ok=True)
+
+    cmd = [
+        "docker", "run", "-d", "--name", name,
+        "--add-host", "host.docker.internal:host-gateway",
+        "-p", "%d:80" % entry["port"],
+        "-v", "%s:/var/lib/fr-gateway-counter" % vol_cnt,
+        "-v", "%s:/var/log/nginx" % vol_log,
+        "--restart", "unless-stopped",
+        "--log-driver", "json-file",
+        "--log-opt", "max-size=10m",
+        "--log-opt", "max-file=3",
+        "-e", "UPSTREAM_URL=http://host.docker.internal:20128/v1",
+        "-e", "UPSTREAM_API_KEY=%s" % raw_key,
+        "-e", "DAILY_TOKEN_LIMIT=%d" % limit,
+        "-e", "RESET_TZ=UTC",
+        "-e", "CLIENT_API_KEY=%s" % entry.get("client_api_key", ""),
+        "-e", "MODEL_FAMILY=%s" % entry.get("model_family", "?"),
+        IMAGE,
+    ]
+    rc, out, err = run(cmd, timeout=180, check=False)
+    if rc != 0:
+        combined = (out + err).lower()
+        if "address already in use" in combined:
+            newport = next_free_port([], avoid={entry["port"]})
+            if newport is not None:
+                log("port %d belegt, nehme %d" % (entry["port"], newport), "warn")
+                entry["port"] = newport
+                return start_container(entry, raw_key)
+        return False
+    log("container %s gestartet auf :%d (family=%s)" % (
+        name, entry["port"], entry.get("model_family", "?")))
+    return True
+
+
+def recreate_container(entry, raw_key):
+    name = entry["container"]
+    run(["docker", "rm", "-f", name], check=False)
+    time.sleep(1)
+    return start_container(entry, raw_key)
+
+
+# ---------------------------------------------------------------------------
+# watch
+# ---------------------------------------------------------------------------
+
+def watch_once(reg, reaper=False):
+    changed = False
+    keys = read_keys()
+    hash_to_raw = {key_hash(k): k for k in keys}
+    pos_of = {key_hash(k): i + 1 for i, k in enumerate(keys)}
+    by_hash = {e["key_hash"]: e for e in reg}
+    m = load_map()
+
+    # neue keys -> container starten
+    for raw in keys:
+        h = key_hash(raw)
+        if h in by_hash:
+            continue
+        entry = {
+            "key_hash": h,
+            "port": None,
+            "container": container_name(raw),
+            "created": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+            "model_family": "astra" if pos_of[h] <= ASTRA_COUNT else "opus",
+            "limit_override": None,
+            "client_api_key": raw_to_unique(m, raw) or "",
+        }
+        p = next_free_port(reg)
+        if p is None:
+            log("kein freier port fuer %s" % h, "error")
+            continue
+        entry["port"] = p
+        if start_container(entry, raw):
+            reg.append(entry)
+            by_hash[h] = entry
+            changed = True
+        else:
+            log("start fehlgeschlagen: %s" % h, "error")
+
+    # bekannte keys -> wiederherstellen / env-diff -> recreate
+    for entry in reg:
+        h = entry["key_hash"]
+        raw = hash_to_raw.get(h)
+        if raw is None:
+            if reaper and container_exists(entry["container"]):
+                run(["docker", "rm", "-f", entry["container"]], check=False)
+                log("reaper: %s entfernt" % entry["container"])
+            continue
+
+        uniq = raw_to_unique(m, raw) or ""
+        need_recreate = False
+        if not container_exists(entry["container"]):
+            log("container fehlt, starte neu: %s" % entry["container"])
+            need_recreate = True
+        else:
+            env = container_env(entry["container"])
+            if env.get("CLIENT_API_KEY", "") != uniq:
+                log("client_api_key geaendert, recreate: %s" % entry["container"])
+                need_recreate = True
+
+        if need_recreate:
+            if entry.get("port") is None:
+                p = next_free_port(reg)
+                if p is None:
+                    continue
+                entry["port"] = p
+            entry["client_api_key"] = uniq
+            if recreate_container(entry, raw):
+                changed = True
+
+    if changed:
+        registry_save(reg)
+
+
+# ---------------------------------------------------------------------------
+# status
+# ---------------------------------------------------------------------------
+
+def read_usage(cont):
+    p = os.path.join(DATA_ROOT, cont, "counter.json")
+    try:
+        with open(p, "r", encoding="utf-8") as f:
+            d = json.load(f)
+        return int(d.get("tokens", 0))
+    except Exception:
+        return 0
+
+
+def cmd_status():
+    reg = registry_load()
+    keys = read_keys()
+    pos_of = {key_hash(k): i + 1 for i, k in enumerate(keys)}
+    now = datetime.datetime.now(datetime.timezone.utc)
+    reset_iso = (now + datetime.timedelta(days=1)).replace(
+        hour=0, minute=0, second=0, microsecond=0
+    ).isoformat()
+
+    rows = []
+    for e in sorted(reg, key=lambda x: pos_of.get(x["key_hash"], 10 ** 9)):
+        h = e["key_hash"]
+        cont = e.get("container", "-")
+        state = "?"
+        if container_exists(cont):
+            running = container_running(cont)
+            state = "running" if running else "stopped"
+        elif h not in pos_of:
+            state = "absent"
+        rows.append((
+            str(pos_of.get(h, "-")),
+            h[:16],
+            str(e.get("port", "-")),
+            cont,
+            state,
+            e.get("model_family", "?"),
+            str(read_usage(cont)),
+            str(e.get("limit_override") or DAILY_LIMIT_DEFAULT),
+            reset_iso,
+        ))
+
+    header = ("nr", "key-hash", "port", "container", "state", "family",
+              "tokens-heute", "limit", "reset-zeitpunkt")
+    widths = [max(len(header[i]), max((len(r[i]) for r in rows), default=0)) for i in range(len(header))]
+    fmt = " | ".join("{:<%d}" % w for w in widths)
+    print(fmt.format(*header))
+    print("-" * (sum(widths) + 3 * (len(header) - 1)))
+    for r in rows:
+        print(fmt.format(*r))
+    print()
+    total = sum(read_usage(e.get("container", "")) for e in reg)
+    print("eintraege=%d keys=%d tokens-heute-gesamt=%d" % (len(reg), len(keys), total))
+
+
+# ---------------------------------------------------------------------------
+# main
+# ---------------------------------------------------------------------------
+
+def main():
+    ap = argparse.ArgumentParser(prog="fr-manager")
+    ap.add_argument("--watch", action="store_true", help="watcher-schleife (30s)")
+    ap.add_argument("--status", action="store_true", help="status-tabelle drucken")
+    ap.add_argument("--reaper", action="store_true", help="fehlende keys entfernen")
+    args = ap.parse_args()
+
+    os.makedirs(BASE, exist_ok=True)
+    if not os.path.exists(KEYS_FILE):
+        if SEED_KEYS:
+            with open(KEYS_FILE, "w", encoding="utf-8") as f:
+                f.write("\n".join(SEED_KEYS) + "\n")
+            os.chmod(KEYS_FILE, 0o600)
+            log("keys_raw.txt angelegt (%d keys)" % len(SEED_KEYS))
+        else:
+            log(
+                "keys_raw.txt fehlt ÔÇö bitte aus keys_raw.txt.example befuellen "
+                "(keine Seed-Keys im Binary)",
+                "error",
+            )
+            return 2
+    if not os.path.exists(REGISTRY_FILE):
+        registry_save([])
+        log("registry.json angelegt (leer)")
+
+    if args.status:
+        cmd_status()
+        return 0
+
+    if not ensure_image():
+        log("image build fehlgeschlagen", "error")
+        return 1
+
+    if args.watch:
+        log("fr-manager watch laeuft (interval=%ds)" % WATCH_INTERVAL)
+        while True:
+            try:
+                watch_once(registry_load(), args.reaper)
+            except Exception as e:
+                log("watch iteration fehler: %s" % e, "error")
+            time.sleep(WATCH_INTERVAL)
+
+    watch_once(registry_load(), args.reaper)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/fr-gateway/docker-compose.yml b/fr-gateway/docker-compose.yml
new file mode 100644
index 0000000..5c965b3
--- /dev/null
+++ b/fr-gateway/docker-compose.yml
@@ -0,0 +1,63 @@
+name: fr-gateway
+
+services:
+  manager:
+    build: ./manager
+    container_name: fr-manager
+    restart: unless-stopped
+    command: watch
+    volumes:
+      - ./secrets/keys_raw.txt:/app/keys_raw.txt:ro
+      - ./upstreams.json:/app/upstreams.json:ro
+      - ./secrets:/app/secrets
+      - ./logs/manager:/var/log/fr-gateway
+      - ./logs/gateways:/var/log/gateways
+      - ./data:/var/lib/gateways
+      - ./gateway:/app/gateway:ro
+      - /var/run/docker.sock:/var/run/docker.sock
+    environment:
+      REGISTRY_FILE: /app/secrets/registry.json
+      KEYS_FILE: /app/keys_raw.txt
+      SECRETS_DIR: /app/secrets
+      PORT_START: "20129"
+      DEFAULT_LIMIT: "2000000"
+      RESET_TZ: UTC
+      WATCH_INTERVAL: "30"
+      UPSTREAM_URL: http://host.docker.internal:20128/v1
+      UPSTREAMS_FILE: /app/upstreams.json
+      NETWORK_NAME: fr-gateway_default
+      GATEWAY_IMAGE: fr-gateway:2026-10-25
+      GATEWAY_BUILD_CONTEXT: /app/gateway
+      DATA_ROOT: /var/lib/gateways
+      LOG_ROOT: /var/log/gateways
+
+  panel:
+    build: ./panel
+    container_name: fr-panel
+    restart: unless-stopped
+    depends_on:
+      - manager
+    ports:
+      # Panel nur lokal: Host-Bind auf loopback. (Container-intern bleibt
+      # uvicorn auf 0.0.0.0, sonst waere der Host-Zugriff technisch tot.)
+      - "127.0.0.1:8090:8090"
+    volumes:
+      - ./secrets/keys_raw.txt:/app/keys_raw.txt:ro
+      - ./upstreams.json:/app/upstreams.json:ro
+      - ./secrets:/app/secrets
+      - ./logs/gateways:/app/logs/gateways
+      - ./data:/app/data
+      - /var/run/docker.sock:/var/run/docker.sock
+    environment:
+      REGISTRY_FILE: /app/secrets/registry.json
+      KEYS_FILE: /app/keys_raw.txt
+      UPSTREAMS_FILE: /app/upstreams.json
+      PANEL_TOKEN: "${PANEL_TOKEN:-}"
+      PANEL_ORIGINS: "http://127.0.0.1:8090,http://localhost:8090"
+      SECRETS_DIR: /app/secrets
+      PORT_START: "20129"
+      DEFAULT_LIMIT: "2000000"
+      NETWORK_NAME: fr-gateway_default
+      GATEWAY_IMAGE: fr-gateway:2026-10-25
+      DATA_ROOT: /app/data
+      LOG_ROOT: /app/logs/gateways
