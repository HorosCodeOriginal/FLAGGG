{
  "name": "fr-harness",
  "version": "1.0.0",
  "description": "Electron workspace-harness — eine isolierte Umgebung pro API-Key",
  "main": "main/main.js",
  "author": "fr",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.2",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.fr.harness",
    "productName": "fr-harness",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../fr-gateway/secrets", "to": "fr-gateway/secrets" }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
